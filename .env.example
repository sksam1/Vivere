# ── VIVERE — environment variables ──────────────────────────────────
# Copy this file to `.env.local` and fill in real values.

# Resend API key — required to actually deliver inquiry emails.
# Get one free at https://resend.com (100 emails/day free).
# Without it, inquiries are still validated + logged, just not emailed.
RESEND_API_KEY=

# Where inquiry notifications are sent (Samuel's inbox).
OWNER_EMAIL=hello@viverehumanperformance.com

# The "from" address. viverehumanperformance.com is verified for sending
# in Resend, so this can be a real address on the domain. If you ever move
# to an unverified domain, fall back to the shared sandbox sender
# "VIVERE <onboarding@resend.dev>", which only delivers to the Resend
# account owner's own email.
FROM_EMAIL=VIVERE <hello@viverehumanperformance.com>

# ── Inquiry store (optional locally) ────────────────────────────────
# On Vercel the marketplace Redis integration injects these automatically,
# so nothing is needed there. Set them locally only to read production
# inquiries with `npm run inquiries`, or to test the durable path.
# The KV_REST_API_* pair is accepted too, whichever the integration sets.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
