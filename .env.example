# ── VIVERE — environment variables ──────────────────────────────────
# Copy this file to `.env.local` and fill in real values.

# Resend API key — required to actually deliver inquiry emails.
# Get one free at https://resend.com (100 emails/day free).
# Without it, inquiries are still validated + logged, just not emailed.
RESEND_API_KEY=

# Where inquiry notifications are sent (Samuel's inbox).
OWNER_EMAIL=hello@viverehp.com

# The "from" address. Until a custom domain is verified in Resend,
# use the shared sandbox sender below (delivers only to the Resend
# account owner's email). After verifying viverehp.com in Resend,
# switch this to e.g. "VIVERE <hello@viverehp.com>".
FROM_EMAIL=VIVERE <onboarding@resend.dev>
